# Hermes secrets template — copy to `.env` and fill in real values.
# The real `.env` is gitignored and must NEVER be committed.
# Location: HERMES_HOME/.env  (C:\Users\Admin\AppData\Local\hermes\.env)

# ── Main model provider ──────────────────────────────────────
# DeepSeek — direct API (not currently the main model, kept as a provider)
DEEPSEEK_API_KEY=

# ── Telegram gateway ─────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot
TELEGRAM_ALLOWED_USERS=
# Default chat/channel the bot posts to (self-test reports, etc.)
TELEGRAM_HOME_CHANNEL=

# ── Web search / auxiliary models ────────────────────────────
# Perplexity — powers web_search backend + most auxiliary tasks (sonar)
PERPLEXITY_API_KEY=

# ── OpenRouter ───────────────────────────────────────────────
# Main model (minimax-m3), delegation (claude-sonnet-4.6), fallback,
# vision (gemini-2.5-flash), and Mixture-of-Agents all route through here.
OPENROUTER_API_KEY=

# ── MCP servers (note the MCP_ prefix — read only by config.yaml mcp_servers) ──
# GitHub MCP server auth
MCP_GITHUB_API_KEY=
# Firecrawl MCP server auth (web scrape/search/crawl tools)
MCP_FIRECRAWL_API_KEY=

# ── Replicate ────────────────────────────────────────────────
# Image generation (google/imagen-4-ultra) + video generation
# (default kwaivgi/kling-v2.1; google/veo-3 available per-call).
REPLICATE_API_TOKEN=
